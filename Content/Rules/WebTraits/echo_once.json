{
  "id": "echo_once",
  "name": "回响复施",
  "description": "由临时回响状态授予。下一次手动施放非回响技能时，先消耗自己的全部回响状态，再额外执行该次完整技能一次；重复执行不算手动输入，不会再次消耗或递归复施。",
  "rules": [{ "id": "echo_consume_repeat", "event": "cast", "conditions": [
    { "op": "tag", "tag": "manual" },
    { "op": "active", "key": "cast_echo", "compare": "ne" }
  ], "actions": [{ "op": "consume_status", "key": "echo", "origin": "owner", "value": "all", "then": [
    { "op": "repeat_skill" }
  ] }] }]
}
