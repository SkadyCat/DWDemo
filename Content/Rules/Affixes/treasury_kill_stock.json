{
  "id": "treasury_kill_stock",
  "name": "击杀敌人时，宝库层数 +n",
  "description": "本聚合技能实际击杀敌人时，为已经启动的宝库增加amount层并刷新闲置计时。amount单位为层；没有击杀不触发，受宝库自身层数上限限制。",
  "params": {
    "amount": 1
  },
  "rules": [
    {
      "id": "treasury_stock_on_kill",
      "event": "kill",
      "chain": {
        "maxDepth": 4
      },
      "conditions": [
        {
          "op": "state",
          "key": "weapons",
          "channel": "royal_treasury",
          "scope": "owner",
          "compare": "gte",
          "value": 1
        }
      ],
      "actions": [
        {
          "op": "emit_event",
          "event": "treasury_feed",
          "amount": {
            "param": "amount"
          }
        }
      ]
    }
  ],
  "parent": "treasury_stock"
}
