{
  "id": "create_blade_dance",
  "name": "刃舞",
  "description": "放出 count 柄环绕自身飞行的刀刃，每柄造成 damage 点物理伤害。本层每 10 次击杀额外多 1 柄（最多 +4）。刀刃每命中 charge_every 次获得一层刃势（伤害 +charge_bonus%）；每 surge_every 层刃势掀起剑刃风暴（攻速 +surge_power%）并向四周甩出 8 柄飞刃。15 杀觉醒：命中追加 30% 伤害的切割；40 杀极境：击杀时从尸体甩出飞刃。",
  "params": {
    "damage": 20,
    "count": 3,
    "cooldown": 0.9,
    "charge_every": 6,
    "charge_bonus": 3,
    "surge_every": 10,
    "surge_power": 35,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
