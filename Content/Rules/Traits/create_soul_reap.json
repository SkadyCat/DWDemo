{
  "id": "create_soul_reap",
  "name": "灵魂收割",
  "description": "挥镰横扫 radius 米内敌人，造成 damage 点虚空伤害。每击杀 charge_every 名敌人获得一层魂火（伤害 +charge_bonus%）；每 surge_every 层魂火化为死神降临（攻速与移速提高）并在击杀点掀起灵魂风暴。15 杀觉醒：击杀时唤出亡魂（最多 3 只）追击敌人；40 杀极境：每次挥镰附带死神之握。",
  "params": {
    "damage": 30,
    "radius": 3,
    "cooldown": 0.5,
    "wraith_damage": 18,
    "charge_every": 1,
    "charge_bonus": 2,
    "surge_every": 15,
    "surge_power": 30,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
