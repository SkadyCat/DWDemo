{
  "id": "create_ground_slam",
  "name": "震地猛击",
  "description": "重击地面，对 radius 米内敌人造成 damage 点物理伤害。每击杀 charge_every 名敌人获得一层地脉（伤害 +charge_bonus%）并从尸体处震出 fissures 道放射地裂；每 surge_every 层地脉引发山崩（伤害与移速提高）与大范围余震。本层击杀成长：15 杀觉醒每次猛击震出放射地裂，40 杀极境追加余震。",
  "params": {
    "damage": 40,
    "radius": 3,
    "cooldown": 0.8,
    "fissures": 6,
    "charge_every": 2,
    "charge_bonus": 6,
    "surge_every": 6,
    "surge_power": 25,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
  "rules": [
