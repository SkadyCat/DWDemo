{
  "id": "create_thunder_strike",
  "name": "雷击三连",
  "description": "向前方雷击，对 radius 米内敌人造成 damage 点闪电伤害并感电。每第 3 击在命中点落下一道 combo_radius 米的雷霆（2.5 倍伤害）。命中感电敌人每 charge_every 次获得一层静电（伤害 +charge_bonus%）；每 surge_every 层静电化为雷神之怒（攻速 +surge_power%，暴击率提高）并引发雷爆。本层击杀成长：15 杀觉醒每击追加连锁落雷，40 杀极境第三击化为雷暴。",
  "params": {
    "damage": 26,
    "radius": 2.2,
    "cooldown": 0.4,
    "combo_radius": 3.6,
    "charge_every": 3,
    "charge_bonus": 5,
    "surge_every": 8,
    "surge_power": 30,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
