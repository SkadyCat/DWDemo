{
  "id": "create_rage_cleave",
  "name": "怒焰劈斩",
  "description": "向前方劈斩，对 radius 米内敌人造成 damage 点物理伤害（技能威力更高时取技能威力）。每命中 charge_every 次获得一层怒意（每层伤害 +charge_bonus%）；每获得 surge_every 层怒意进入狂暴（攻速 +surge_power%）并在命中点放出冲击波。本层击杀成长：每次击杀伤害 +1%（上限 40）；15 杀觉醒：劈斩附带烈焰余波；40 杀极境：再追加一圈烈焰旋斩。",
  "params": {
    "damage": 30,
    "radius": 2.6,
    "cooldown": 0.45,
    "charge_every": 3,
    "charge_bonus": 4,
    "surge_every": 8,
    "surge_power": 35,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
  "rules": [
    {
