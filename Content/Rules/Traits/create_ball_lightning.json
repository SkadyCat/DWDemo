{
  "id": "create_ball_lightning",
  "name": "球状闪电",
  "description": "向前方放出缓慢推进的雷球，贯穿沿途敌人，造成 damage 点闪电伤害并感电。每命中 charge_every 次感电敌人获得一层电荷（伤害 +charge_bonus%）；每 surge_every 层电荷进入雷暴（施法速度 +surge_power%）并向四周放出 6 颗雷球。15 杀觉醒：雷球命中时放出电弧；40 杀极境：每次施放 2 颗雷球。",
  "params": {
    "damage": 18,
    "count": 1,
    "cooldown": 0.6,
    "charge_every": 4,
    "charge_bonus": 4,
    "surge_every": 10,
    "surge_power": 25,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
  "rules": [
    {
      "id": "ball_lightning_cast",
      "event": "cast",
      "actions": [
        {
          "op": "emit",
          "kind": "ball_lightning",
          "origin": "owner",
          "element": "lightning",
          "tags": [
            "lightning",
            "spell",
            "projectile"
          ],
          "count": {
            "add": [
              {
                "param": "count"
              },
              {
                "min": [
                  1,
                  {
                    "div": [
                      {
                        "state": "growth"
                      },
                      {
                        "param": "ultimate_at"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "spread": 18,
          "speed": 7,
          "lifetime": 2.4,
          "radius": 0.8,
          "pierce": 99,
          "damage": {
            "max": [
              {
                "param": "damage"
              },
              {
                "event": "amount"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "ball_lightning_feed",
      "event": "hit",
      "chain": {
        "maxDepth": 3
      },
      "conditions": [
        {
          "op": "status",
          "key": "shock",
          "compare": "gte",
          "value": 1
        }
      ],
      "actions": [
        {
          "op": "counter",
          "key": "feed",
          "value": 1,
          "threshold": {
            "param": "charge_every"
          },
          "then": [
            {
              "op": "apply_status",
              "key": "ball_lightning_charge",
              "origin": "owner",
              "value": {
                "param": "charge_bonus"
              },
              "duration": {
                "param": "charge_duration"
              }
            },
            {
              "op": "counter",
              "key": "surge",
              "value": 1,
              "threshold": {
                "param": "surge_every"
              },
              "then": [
                {
                  "op": "apply_status",
                  "key": "ball_lightning_surge",
                  "origin": "owner",
                  "value": {
                    "param": "surge_power"
                  },
                  "duration": {
                    "param": "surge_duration"
                  }
                },
                {
                  "op": "emit",
                  "kind": "ball_lightning",
                  "origin": "owner",
                  "layout": "radial",
                  "element": "lightning",
                  "tags": [
                    "lightning",
                    "spell",
                    "projectile"
                  ],
                  "count": 6,
                  "speed": 8,
                  "lifetime": 1.6,
                  "radius": 0.8,
                  "pierce": 99,
                  "damage": {
                    "max": [
                      {
                        "param": "damage"
                      },
                      {
                        "event": "amount"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "ball_lightning_grow",
      "event": "kill",
      "chain": {
        "maxDepth": 4
      },
      "actions": [
        {
          "op": "counter",
          "key": "growth",
          "value": 1,
          "cap": {
            "param": "growth_cap"
          }
        },
        {
          "op": "apply_status",
          "key": "ball_lightning_growth",
          "origin": "owner",
          "value": {
            "param": "growth_bonus"
          },
          "duration": 900
        }
      ]
    },
    {
      "event": "hit",
      "chain": {
        "maxDepth": 1
      },
      "actions": [
        {
          "op": "damage_area",
          "element": "lightning",
          "tags": [
            "lightning",
            "spell",
            "arc"
          ],
          "radius": 2.2,
          "amount": {
            "mul": [
              {
                "max": [
                  {
                    "param": "damage"
                  },
                  {
                    "event": "amount"
                  }
                ]
              },
              0.5
            ]
          }
        }
      ],
      "id": "ball_lightning_awaken_1",
      "conditions": [
        {
          "op": "state",
          "key": "growth",
          "compare": "gte",
          "value": {
            "param": "awaken_at"
          }
        }
      ]
    }
  ]
}
