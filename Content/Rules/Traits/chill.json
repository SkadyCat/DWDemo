{
  "id": "chill",
  "name": "冰缓",
  "description": "任何冰冷命中都会让目标冰缓：移动与攻击变慢。同名状态不叠层，取最强值和最长时间。",
  "params": { "slow": 30, "duration": 2.0 },
  "rules": [
    {
      "id": "chill_on_cold_hit",
