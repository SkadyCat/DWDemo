      "conditions": [ { "op": "tag", "tag": "cold" } ],
      "actions": [
        { "op": "apply_status", "key": "chill", "value": { "param": "slow" }, "duration": { "param": "duration" }, "cap": 70 }
      ]
    }
  ]
}