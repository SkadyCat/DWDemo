        {
          "op": "damage_area",
          "element": "frost",
          "tags": [
            "cold",
            "spell",
            "nova"
          ],
          "radius": {
            "param": "radius"
          },
          "amount": {
            "max": [
              {
                "param": "damage"
              },
              {
                "event": "amount"
              }
            ]
          }
        }
      ]
    },
    {
