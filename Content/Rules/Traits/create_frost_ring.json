{
  "id": "create_frost_ring",
  "name": "霜环",
  "description": "以自身为中心爆开寒霜，对 radius 米内敌人造成 damage 点冰霜伤害并冰缓。每击杀 charge_every 名冰缓敌人获得一层霜寒（伤害 +charge_bonus%）；每 surge_every 层霜寒引发冰封新星（大范围 3 倍伤害，施法速度提高）。15 杀觉醒：每次施法向四周射出 6 枚冰锥；40 杀极境：击杀冰缓敌人时原地碎冰爆炸。",
  "params": {
    "damage": 24,
    "radius": 3.6,
    "cooldown": 0.7,
    "charge_every": 2,
    "charge_bonus": 5,
    "surge_every": 8,
    "surge_power": 25,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
  "rules": [
    {
      "id": "frost_ring_cast",
      "event": "cast",
