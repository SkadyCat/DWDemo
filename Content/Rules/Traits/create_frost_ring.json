                  "origin": "owner",
                  "value": {
                    "param": "surge_power"
                  },
                  "duration": {
                    "param": "surge_duration"
                  }
                },
                {
                  "op": "damage_area",
                  "element": "frost",
                  "tags": [
                    "cold",
                    "spell",
                    "nova"
                  ],
                  "radius": 7,
                  "amount": {
