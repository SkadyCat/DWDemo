          "compare": "gte",
          "value": 1
        }
      ],
      "actions": [
        {
          "op": "counter",
          "key": "feed",
          "value": 1,
          "threshold": {
            "param": "charge_every"
          },
          "then": [
            {
              "op": "apply_status",
              "key": "frost_ring_charge",
              "origin": "owner",
              "value": {
                "param": "charge_bonus"
              },
              "duration": {
                "param": "charge_duration"
              }
            },
            {
