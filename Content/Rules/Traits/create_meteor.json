{
  "id": "create_meteor",
  "name": "天火陨星",
  "description": "在落点召下陨星，对 radius 米内敌人造成 damage 点火焰伤害并点燃。每击杀 charge_every 名敌人获得一层星火（伤害 +charge_bonus%）；每 surge_every 层星火进入星陨（施法速度 +surge_power%）并从尸体向四周迸裂 8 枚火球。15 杀觉醒：每次施法额外射出 3 枚火球；40 杀极境：每 5 次命中引发余烬爆炸。",
  "params": {
    "damage": 44,
    "radius": 3,
    "cooldown": 0.9,
    "charge_every": 2,
    "charge_bonus": 5,
    "surge_every": 8,
    "surge_power": 30,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
  "rules": [
    {
      "id": "meteor_cast",
      "event": "cast",
      "actions": [
        {
          "op": "damage_area",
          "element": "fire",
          "tags": [
            "fire",
            "spell",
            "meteor"
          ],
          "radius": {
            "param": "radius"
          },
          "amount": {
            "max": [
              {
                "param": "damage"
              },
              {
                "event": "amount"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "meteor_feed",
      "event": "kill",
      "chain": {
        "maxDepth": 3
      },
      "conditions": [],
      "actions": [
        {
          "op": "counter",
          "key": "feed",
          "value": 1,
          "threshold": {
            "param": "charge_every"
          },
          "then": [
            {
              "op": "apply_status",
              "key": "meteor_charge",
              "origin": "owner",
              "value": {
                "param": "charge_bonus"
              },
              "duration": {
                "param": "charge_duration"
              }
            },
            {
              "op": "counter",
              "key": "surge",
              "value": 1,
              "threshold": {
                "param": "surge_every"
              },
              "then": [
                {
                  "op": "apply_status",
                  "key": "meteor_surge",
                  "origin": "owner",
                  "value": {
                    "param": "surge_power"
                  },
                  "duration": {
                    "param": "surge_duration"
                  }
                },
                {
                  "op": "emit",
                  "kind": "fireball",
                  "origin": "event",
                  "layout": "radial",
                  "element": "fire",
                  "tags": [
                    "fire",
                    "spell",
                    "projectile"
                  ],
                  "count": 8,
                  "speed": 16,
                  "lifetime": 0.6,
                  "radius": 0.4,
                  "damage": {
                    "mul": [
                      {
                        "max": [
                          {
                            "param": "damage"
                          },
                          {
                            "event": "amount"
                          }
                        ]
                      },
                      0.8
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "meteor_grow",
      "event": "kill",
      "chain": {
        "maxDepth": 4
      },
      "actions": [
        {
          "op": "counter",
          "key": "growth",
          "value": 1,
          "cap": {
            "param": "growth_cap"
          }
        },
        {
          "op": "apply_status",
          "key": "meteor_growth",
          "origin": "owner",
          "value": {
            "param": "growth_bonus"
          },
          "duration": 900
        }
      ]
    },
    {
      "event": "cast",
      "actions": [
        {
          "op": "emit",
          "kind": "fireball",
          "origin": "owner",
          "element": "fire",
          "tags": [
            "fire",
            "spell",
            "projectile"
          ],
          "count": 3,
          "spread": 30,
          "speed": 20,
          "lifetime": 0.9,
          "radius": 0.4,
          "damage": {
            "mul": [
              {
                "max": [
                  {
                    "param": "damage"
                  },
                  {
                    "event": "amount"
                  }
                ]
              },
              0.5
            ]
          }
        }
      ],
      "id": "meteor_awaken_1",
      "conditions": [
        {
          "op": "state",
          "key": "growth",
          "compare": "gte",
          "value": {
            "param": "awaken_at"
          }
        }
      ]
    },
    {
      "event": "hit",
      "chain": {
        "maxDepth": 1
      },
      "actions": [
        {
          "op": "counter",
          "key": "ember",
          "value": 1,
          "threshold": 5,
          "then": [
            {
              "op": "damage_area",
              "element": "fire",
              "tags": [
                "fire",
                "spell"
              ],
              "radius": 2.6,
              "amount": {
                "max": [
                  {
                    "param": "damage"
                  },
                  {
                    "event": "amount"
                  }
                ]
              }
            }
          ]
        }
      ],
      "id": "meteor_ultimate_1",
      "conditions": [
        {
          "op": "state",
          "key": "growth",
          "compare": "gte",
          "value": {
            "param": "ultimate_at"
          }
        }
      ]
    }
  ]
}
