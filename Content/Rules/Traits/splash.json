{
  "id": "splash",
  "name": "溅射",
  "description": "投射物命中敌人时，在命中点追加同元素范围伤害，包含原命中目标。radius 为半径（米），ratio 为本次投射物结算前伤害的倍率，默认 2 米、0.5 倍；范围受现有范围属性影响。多重与穿透的每次命中独立触发。溅射使用独立命中事件，不递归溅射，也不自动复制原技能的命中时特性。",
  "params": { "radius": 2, "ratio": 0.5 },
  "rules": [
    {
      "id": "splash_on_projectile_hit",
      "event": "hit",
      "chain": { "maxDepth": 4 },
      "conditions": [ { "op": "tag", "tag": "projectile" } ],
      "actions": [
        {
          "op": "damage_area",
          "emitEvent": "splash_hit",
          "radius": { "param": "radius" },
          "amount": { "mul": [ { "event": "damage" }, { "param": "ratio" } ] }
        }
      ]
    }
  ]
}
