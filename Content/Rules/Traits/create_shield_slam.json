{
  "id": "create_shield_slam",
  "name": "盾击",
  "description": "以盾猛击 radius 米内敌人，造成 damage 点物理伤害。每命中 charge_every 次获得一层壁垒（承受伤害 -charge_bonus%）；每 surge_every 层壁垒化为不动如山（承受伤害大幅降低、伤害提高）并震荡周围。本层击杀成长：15 杀觉醒猛击附带一圈盾震，40 杀极境命中时连环余震。",
  "params": {
    "damage": 26,
    "radius": 2.4,
    "cooldown": 0.5,
    "charge_every": 2,
    "charge_bonus": 4,
    "surge_every": 10,
    "surge_power": 30,
    "growth_cap": 40,
    "growth_bonus": 1,
    "awaken_at": 15,
    "ultimate_at": 40,
    "charge_duration": 6,
    "surge_duration": 5
  },
