{
  "id": "timed_on_kill",
  "name": "附带持续时间·击杀后",
  "description": "附带持续时间：击杀敌人后，自身获得缝合的特性，持续 duration 秒。chance 为触发概率（%）。再次触发刷新时间，不叠加。",
  "params": { "duration": 4, "chance": 100 },
  "rules": [
    {
      "id": "grant_on_kill",
      "event": "kill",
      "chain": { "maxDepth": 4 },
      "conditions": [ { "op": "chance", "probability": { "param": "chance" } } ],
      "actions": [ { "op": "grant_traits", "origin": "owner", "traits": "stitched", "duration": { "param": "duration" } } ]
    }
  ]
}
