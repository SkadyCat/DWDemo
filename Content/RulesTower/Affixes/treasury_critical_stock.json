{
  "id": "treasury_critical_stock",
  "name": "投射物暴击时，宝库层数 +n",
  "description": "投射物暴击时，通过补层事件为已经启动的宝库增加amount层并刷新闲置计时。amount单位为层；必须实际暴击，受宝库自身层数上限限制。",
  "params": {
    "amount": 1
  },
  "rules": [
    {
      "id": "treasury_stock_on_critical",
      "event": "critical",
      "chain": {
        "maxDepth": 4
      },
      "conditions": [
        {
          "op": "tag",
          "tag": "projectile"
        },
        {
          "op": "state",
          "key": "weapons",
          "channel": "royal_treasury",
          "scope": "owner",
          "compare": "gte",
          "value": 1
        }
      ],
      "actions": [
        {
          "op": "emit_event",
          "event": "treasury_feed",
          "amount": {
            "param": "amount"
          }
        }
      ]
    }
  ],
  "parent": "treasury_stock"
}
