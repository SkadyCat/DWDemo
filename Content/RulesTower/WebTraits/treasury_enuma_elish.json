{
  "id": "treasury_enuma_elish",
  "name": "天地乖离剑",
  "description": "王之宝库专属主动：消耗自己的全部宝库层数，从头顶巨大法阵投射乖离剑轰向点击位置。基础物理伤害32；本次技能伤害额外提高消耗层数×50%，10层为6倍、40层为21倍，包含装备点伤。无层数不产生投射物，消耗后停止宝库自动出射，必须重新启动宝库。使用真实抛物投射规则；count基础为1枚，投射物词条正常聚合。",
  "params": { "damage": 32, "per_layer": 0.5, "height": 5.4, "speed": 24, "lifetime": 0.8, "radius": 0.6, "cooldown": 0.65 },
  "rules": [
    {
      "id": "treasury_finisher",
      "event": "cast",
      "conditions": [{ "op": "active", "key": "treasury_enuma_elish" }],
      "actions": [
        {
          "op": "consume", "scope": "owner", "channel": "royal_treasury", "key": "weapons", "value": "all",
          "then": [
            { "op": "multiply_damage", "value": { "add": [1, { "mul": [{ "event": "stored_value" }, { "param": "per_layer" }] }] } },
            {
              "op": "emit", "kind": "treasury_ea", "origin": "owner", "layout": "point", "trajectory": "parabolic", "arc_height": 0,
              "offset": { "forward": -0.6, "up": { "param": "height" } },
              "element": "physical", "tags": ["physical", "spell"], "count": 1,
              "damage": { "param": "damage" }, "speed": { "param": "speed" }, "lifetime": { "param": "lifetime" }, "radius": { "param": "radius" }
            }
          ]
        }
      ]
    }
  ]
}
