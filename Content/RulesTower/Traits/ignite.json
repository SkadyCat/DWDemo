{
  "id": "ignite",
  "name": "点燃",
  "description": "火焰命中点燃目标：每秒造成该次实际伤害 40% 的火焰伤害，持续 4 秒。同名取最强。",
  "params": { "ratio": 0.4, "duration": 4 },
  "rules": [
    {
      "id": "ignite_on_fire_hit",
      "event": "hit",
      "chain": { "maxDepth": 4 },
      "conditions": [ { "op": "tag", "tag": "fire" } ],
      "actions": [ { "op": "apply_status", "key": "ignite", "value": { "mul": [ { "event": "amount" }, { "param": "ratio" } ] }, "duration": { "param": "duration" } } ]
    },
    {
      "id": "ignite_on_fire_damage",
      "event": "fire_damage_hit",
      "chain": { "maxDepth": 4 },
      "actions": [ { "op": "apply_status", "key": "ignite", "value": { "mul": [ { "event": "amount" }, { "param": "ratio" } ] }, "duration": { "param": "duration" } } ]
    }
  ]
}
