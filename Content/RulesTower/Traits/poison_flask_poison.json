{
  "id": "poison_flask_poison",
  "name": "毒瓶施毒",
  "parent": "throw_poison_flask",
  "description": "辅助毒瓶，使其范围命中时触发中毒；基础中毒持续时间 +duration 秒。duration 为基础中毒持续时间（秒）。中毒沿用现有逐层结算：基础每秒伤害为本次实际命中伤害的 20%，并受现有中毒词条影响。",
  "params": { "duration": 2 },
  "rules": [
    {
      "id": "poison_on_flask_burst", "event": "poison_flask_hit", "chain": { "maxDepth": 4 },
      "actions": [ { "op": "apply_status", "key": "poison", "value": { "event": "amount" }, "duration": { "param": "duration" } } ]
    }
  ]
}
