{
  "id": "summon_ice_turret",
  "name": "召唤冰锥炮台",
  "description": "在施法位置召唤固定炮台，向 range 米内最近的存活敌人发射冰锥。duration 为存在秒数（默认 8），interval 为发射间隔秒数（默认 1），damage 为基础伤害，speed 为弹速（米/秒），lifetime 为冰锥飞行秒数，projectile_radius 为碰撞半径（米）。默认索敌 10 米，冰锥飞行约 10.8 米；多重、穿透、弹射及其他投射物修饰照常生效。重复施法替换旧炮台并保留下一次发射时间，不会加快射速。",
  "params": { "duration": 8, "interval": 1, "range": 10, "damage": 16, "speed": 24, "lifetime": 0.45, "projectile_radius": 0.22 },
  "rules": [
    {
      "id": "summon_turret", "event": "cast",
      "actions": [
        { "op": "summon", "kind": "ice_turret", "event": "ice_turret_fire", "duration": { "param": "duration" }, "interval": { "param": "interval" }, "radius": { "param": "range" }, "cap": 1 }
      ]
    },
    {
      "id": "turret_spits_ice_lance", "event": "ice_turret_fire",
      "actions": [
        { "op": "emit", "kind": "ice_lance", "element": "frost", "tags": ["frost", "cold", "spell"], "speed": { "param": "speed" }, "lifetime": { "param": "lifetime" }, "radius": { "param": "projectile_radius" }, "damage": { "max": [{ "param": "damage" }, { "event": "amount" }] } }
      ]
    }
  ]
}
