{
  "id": "bleed",
  "name": "流血",
  "description": "物理命中有概率造成流血：每层每秒造成该次实际伤害 25% 的物理伤害，最多 5 层。",
  "params": { "chance": 50, "ratio": 0.25, "duration": 5 },
  "rules": [
    {
      "id": "bleed_on_physical_hit",
      "event": "hit",
      "chain": { "maxDepth": 4 },
      "conditions": [ { "op": "tag", "tag": "physical" }, { "op": "chance", "value": { "param": "chance" } } ],
      "actions": [ { "op": "apply_status", "key": "bleed", "value": { "mul": [ { "event": "amount" }, { "param": "ratio" } ] }, "duration": { "param": "duration" } } ]
    },
    {
      "id": "bleed_on_physical_damage",
      "event": "physical_damage_hit",
      "chain": { "maxDepth": 4 },
      "conditions": [ { "op": "chance", "value": { "param": "chance" } } ],
      "actions": [ { "op": "apply_status", "key": "bleed", "value": { "mul": [ { "event": "amount" }, { "param": "ratio" } ] }, "duration": { "param": "duration" } } ]
    },
    {
      "id": "bleed_on_slash",
      "event": "slash_hit",
      "chain": { "maxDepth": 4 },
      "conditions": [ { "op": "chance", "value": { "param": "chance" } } ],
      "actions": [ { "op": "apply_status", "key": "bleed", "value": { "mul": [ { "event": "amount" }, { "param": "ratio" } ] }, "duration": { "param": "duration" } } ]
    }
  ]
}
