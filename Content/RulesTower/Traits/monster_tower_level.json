{
  "id": "monster_tower_level",
  "name": "塔层级",
  "description": "怪物生成时按所在塔层修饰生命上限与造成的命中伤害。level 为塔层（从第 1 层起）；life_growth 为每升一层的生命倍率，默认 2；damage_growth 为每升一层的伤害倍率，默认 1.2。第 1 层不加成，第 N 层分别乘 life_growth^(N-1) 与 damage_growth^(N-1)。同一怪物仅保留一份，更新层级时按原始属性重算，不重复累乘；生命上限及伤害倍率沿用引擎 10 亿硬上限。",
  "params": {
    "level": 1,
    "life_growth": 2,
    "damage_growth": 1.2
  },
  "modifiers": [
    {
      "target": "owner",
      "stat": "max_life",
      "op": "multiply",
      "value": { "pow": [{ "param": "life_growth" }, { "max": [0, { "add": [{ "param": "level" }, -1] }] }] }
    },
    {
      "target": "owner",
      "stat": "damage_multiplier",
      "op": "multiply",
      "value": { "pow": [{ "param": "damage_growth" }, { "max": [0, { "add": [{ "param": "level" }, -1] }] }] }
    }
  ]
}
